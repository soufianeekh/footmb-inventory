# Existing Shopify application credentials (server only)
SHOPIFY_SHOP=your-shop.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10

# Existing FOOTMB administrator authentication
FOOTMB_ADMIN_EMAIL=
FOOTMB_ADMIN_PASSWORD_HASH_B64=
AUTH_SECRET=

# Durable inventory snapshots, queue, locks, and webhook deduplication
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
INVENTORY_REDIS_PREFIX=footmb:inventory:v2
INVENTORY_SYNC_SECRET=

# Stable Shopify location IDs are recommended. Names are used only as a first-sync fallback.
SHOPIFY_LOCATION_CASA_ID=
SHOPIFY_LOCATION_TANGER_ID=
SHOPIFY_LOCATION_STOCK_CASA_ID=

# Public production origin used by the webhook registration script
PUBLIC_APP_URL=https://your-site.example.com
